# Copy to .env for local overrides, or set these in the host's environment.
# .env is gitignored; this file is documentation and holds no real values.

# development (default) or production.
# production requires a real SECRET_KEY, turns on Secure cookies and never seeds
# the sample data or the demo login.
APP_ENV=development

# Required when APP_ENV=production; the app refuses to start without it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
SECRET_KEY=

# Where the SQLite file lives. In production point this at a mounted volume,
# or the data is thrown away on every redeploy. Daily backups are written to a
# backups/ directory beside it.
DATABASE_PATH=expense_tracker.db

# The users' calendar day, not the server's. Expense dates follow this zone.
APP_TIMEZONE=Asia/Kolkata

# Set to false to close /register on a public instance. Anything else leaves it open.
ALLOW_REGISTRATION=true

# Port to bind. Railway sets this itself.
PORT=5001
